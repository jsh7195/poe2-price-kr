{
  "name": "poe2-price-kr",
  "productName": "PoE2 시세검색",
  "version": "1.5.1",
  "description": "Path of Exile 2 가격을 한글 이름으로 검색하는 데스크톱 앱 (GGG 거래소 실시간 시세 + 옵션 검색, poe.ninja 화폐 시세 + 공식 GGG 한글 데이터)",
  "main": "src/main/main.js",
  "author": "jsh71",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "smoke": "node scripts/smoke.js",
    "dist": "electron-builder --win",
    "pack": "electron-builder --dir",
    "release": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.jsh71.poe2pricekr",
    "productName": "PoE2 시세검색",
    "publish": {
      "provider": "github",
      "owner": "jsh7195",
      "repo": "poe2-price-kr",
      "releaseType": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "!**/*.map"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "portable": {
      "artifactName": "PoE2-Price-KR-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "PoE2-Price-KR-${version}-setup.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  }
}
